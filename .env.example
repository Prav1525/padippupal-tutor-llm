# Google Gemini API. Keep secrets in local .env or Render environment variables only.
GEMINI_API_KEY=
# Create a File Search store using scripts/setup_google_file_search.py, then paste its name here.
GEMINI_FILE_SEARCH_STORE=
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative: any OpenAI-compatible chat completions endpoint (e.g. hosted/self-hosted Gemma).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Local development only; use a separate managed database in deployment.
DATABASE_PATH=./padippupal_tutor.sqlite3
SYLLABUS_DIR=./syllabus
